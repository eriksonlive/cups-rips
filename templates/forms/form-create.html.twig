{% extends 'components/modal-component.html.twig' %}

{% block modal_title %}
	<div x-text="update ? 'Actualizar Cups': 'Crear Cups'"></div>
{% endblock %}

{% block body %}
	<form method="post" action="{{ path('app_example_create') }}">

		<div class="mt-5 grid grid-cols-2 gap-4" x-data="formHandler()" @form-update.window="handleExample($event)" data-groups="{{ groupedData|json_encode|e('html_attr') }}">
			<div class="col-span-2">
				<label for="cups" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Cups</label>
				<select
					id="cups" name="cups" data-placeholder="Buscar descripción..." data-url="{{ path('cups') }}" x-bind:data-default="initialState.cups" class="codigo-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40">
					<!-- Reemplaza con tu URL de búsqueda -->
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				{% if errors['cups'] is defined %}
					<div class="text-red-500 mt-[-20px]">
						{% for error in errors['cups'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div>
				<label for="tipo_cita" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Tipo cita</label>
				<select id="tipo_cita" x-bind:value="initialState.tipoCita" name="tipo_cita" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción...">
					<option value="" disabled selected>Seleccione una opción</option>
					<option value="1">Consulta</option>
					<option value="2">Procedimiento</option>
				</select>
				{% if errors['tipo_cita'] is defined %}
					<div class="error text-red-500">
						{% for error in errors['tipo_cita'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div class="mt-6 space-y-5">
				<div class="flex items-center space-x-3 cursor-pointer" x-model="initialState.show" @click="initialState.show =!initialState.show">
					<input type="hidden" name="informe_oportunidad" value="false"/>
					<div class="relative w-10 h-5 transition duration-200 ease-linear rounded-full" :class="[initialState.show ? 'bg-indigo-500' : 'bg-gray-300']">
						<label for="show" @click="initialState.show =!initialState.show" class="absolute left-0 w-5 h-5 mb-2 transition duration-100 ease-linear transform bg-white border-2 rounded-full cursor-pointer" :class="[initialState.show ? 'translate-x-full border-indigo-500' : 'translate-x-0 border-gray-300']"></label>
						<input type="checkbox" name="informe_oportunidad" :checked="initialState.show" :value="initialState.show ? 'true' : 'false'" class="hidden w-full h-full rounded-full appearance-none active:outline-none focus:outline-none"/>
					</div>

					<p class="text-gray-500">Informe Oportunidad</p>
				</div>
			</div>

			<div>
				<!-- Primer select: Grupos -->
				<label for="grupo" class="block text-sm text-gray-700 capitalize dark:text-gray-200">Grupo Servicio</label>
				<select id="grupo" name="grupo" x-model="selectedGroup" @change="updateServices()" x-bind:value="initialState.grupo" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40">
					<option value="" disabled selected>Seleccione un grupo</option>
					<template x-for="(group, groupCode) in groups" :key="groupCode">
						<option :value="groupCode" x-text="group.nombre"></option>
					</template>
				</select>
				{% if errors['grupo'] is defined %}
					<div class="error text-red-500">
						{% for error in errors['grupo'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div>
				<label for="servicio" class="block text-sm text-gray-700 capitalize dark:text-gray-200">Codigo Servicio</label>
				<select id="servicio" name="servicio" x-model="initialState.servicio" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" :disabled="!services.length">
					<option value="" disabled selected x-show="!services.length">Seleccione un servicio</option>
					<template x-for="service in services" :key="service.codigo">
						<option :value="service.codigo" x-text="service.nombre"></option>
					</template>
				</select>
				{% if errors['servicio'] is defined %}
					<div class="error text-red-500">
						{% for error in errors['servicio'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div>
				<label for="diag" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Diagnostico por defecto</label>
				<select
					id="diag" name="diag" x-bind:data-default="initialState.diag" class="codigo-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción..." data-url="{{ path('diagnostico_suggestions') }}">
					<!-- Reemplaza con tu URL de búsqueda -->
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				{% if errors['diag'] is defined %}
					<div class="error text-red-500 mt-[-20px]">
						{% for error in errors['diag'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div>
				<label for="tipo_diag" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Tipo Diagnóstico</label>
				<select id="tipo_diag" name="tipo_diag" x-model="initialState.tipoDiag" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción...">
					<option value="" disabled selected>Seleccione una opción</option>
					<option value="01">Impresión diagnóstica</option>
					<option value="02">Confirmado Nuevo</option>
					<option value="03">Confirmado Repetido</option>
				</select>
				{% if errors['tipo_diag'] is defined %}
					<div class="error text-red-500">
						{% for error in errors['tipo_diag'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div>
				<label for="causa_externa" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Causa Externa</label>
				<select
					id="causa_externa" name="causa_externa" x-bind:data-default="initialState.causa" class="choices-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción..." data-url="{{ path('causa_externa') }}">
					<!-- Reemplaza con tu URL de búsqueda -->
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				{% if errors['causa_externa'] is defined %}
					<div class="error text-red-500 mt-[-20px]">
						{% for error in errors['causa_externa'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div>
				<label for="finalidad" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Finalidad</label>
				<select id="finalidad" name="finalidad" data-url="{{ path('finalidad_data') }}" x-bind:data-default="initialState.finalidad" class="choices-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción...">
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				{% if errors['finalidad'] is defined %}
					<div class="error text-red-500 mt-[-20px]">
						{% for error in errors['finalidad'] %}
							<p>{{ error }}</p>
						{% endfor %}
					</div>
				{% endif %}
			</div>

			<div class="flex justify-end mt-6 col-span-2">
				<button type="submit" class="px-3 py-2 text-sm tracking-wide text-white capitalize transition-colors duration-200 transform bg-green-500 rounded dark:bg-green-600 dark:hover:bg-green-700 dark:focus:bg-green-700 hover:bg-green-600 focus:outline-none focus:bg-green-500 focus:ring focus:ring-green-300 focus:ring-opacity-50">
					Crear
				</button>
			</div>
		</div>
	</form>


	 <script>
			    document.addEventListener('alpine:init', () => {
			        Alpine.data('formHandler', () => ({
			            groups: JSON.parse(document.querySelector('[data-groups]').getAttribute('data-groups')),
			            selectedGroup: '',
			            services: [],
						url: '/edit',
			            itemId: null,
			            initialState: Object.freeze({
			                cups: null,
			                diag: null,
			                causa: null,
			                finalidad: null,
                            grupo: null,
			                servicio: null,
			                tipoCita: null,
			                tipoDiag: null,
			                show: true,
			            }),
			            updateServices() {
			                this.services = this.selectedGroup ? this.groups[this.selectedGroup].items : [];
			            },
						handleExample(event){
		                    this.itemId = event.detail.id ? event.detail?.id: null;
						},
						init() {
							this.$watch('itemId', () => {
								this.loadChoicesData();
							});
						},
						loadChoicesData() {
							if (this.url && this.itemId) {
								fetch(`${this.url}/${this.itemId}`)
								.then(response => response.json())
								.then(data => {
			                        this.initialState = {
			                            ...this.initialState,
			                            cups: data.cups,
			                            diag: data.diag,
			                            causa: data.causa_externa,
			                            finalidad: data.finalidad,
			                            tipoCita: data.tipo_cita,
			                            tipoDiag: data.tipo_diag,
			                            show: data.informe,
                                        grupo: data.grupo,
			                        }
                                    this.selectedGroup = data.grupo;
			                        this.updateServices();
                                    this.initialState.servicio = data.servicio;
								})
								.catch(error => console.error('Error al cargar opciones iniciales:', error));
							} else {
		                        this.cleanState();
		                    }
						},
		                cleanState(){
		                    this.initialState = {
		                        cups: null,
		                        diag: null,
		                        causa: null,
		                        finalidad: null,
		                        servicio: "",
		                        tipoCita: "",
		                        tipoDiag: "",
		                        show: null
		                    };
                            this.selectedGroup = "";
                            this.updateServices();
		                }
			        }));
			    });
			</script>

{% endblock %}
