{% extends 'components/modal-component.html.twig' %}

{% block modal_title %}
	<div x-text="update ? 'Actualizar Cups': 'Crear Cups'"></div>
{% endblock %}

{% block body %}
	<form method="post" action="{{ path('create_as_consult') }}" x-data="formHandler()" @submit.prevent="!itemId ? submitForm : updateData" data-update="{{ path('update_as_consult', {'id': 'id'}) }}" data-getid="{{ path('get_as_consult_by_id', {'id': 'id'}) }}">
		<div class="mt-5 grid grid-cols-2 gap-4" @form-update.window="handleExample($event)" data-groups="{{ groupedData|json_encode|e('html_attr') }}">
			<div class="col-span-2">
				<label for="cups" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Cups</label>
				<select
					id="cups" name="cups" data-placeholder="Buscar descripción..." data-url="{{ path('get_list_as_cups') }}" x-bind:data-default="initialState.cups" class="codigo-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40">
					<!-- Reemplaza con tu URL de búsqueda -->
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				<div x-show="errors.cups" class="text-red-500 mt-[-20px] text-[14px]">
					<p x-text="errors.cups"></p>
				</div>
			</div>

			<div>
				<label for="tipo_cita" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Tipo cita</label>
				<select id="tipo_cita" x-bind:value="initialState.tipoCita" name="tipo_cita" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción...">
					<option value="" disabled selected>Seleccione una opción</option>
					<option value="1">Consulta</option>
					<option value="2">Procedimiento</option>
				</select>
				<div x-show="errors.tipo_cita" class="text-red-500 text-[14px]">
					<p x-text="errors.tipo_cita"></p>
				</div>
			</div>

			<div class="mt-6 space-y-5">
				<div class="flex items-center space-x-3 cursor-pointer" x-model="show" @click="show =!show">
					<input type="hidden" name="informe_oportunidad" value="false"/>
					<div class="relative w-10 h-5 transition duration-200 ease-linear rounded-full" :class="[show ? 'bg-indigo-500' : 'bg-gray-300']">
						<label for="show" @click="show =!show" class="absolute left-0 w-5 h-5 mb-2 transition duration-100 ease-linear transform bg-white border-2 rounded-full cursor-pointer" :class="[show ? 'translate-x-full border-indigo-500' : 'translate-x-0 border-gray-300']"></label>
						<input type="checkbox" name="informe_oportunidad" :checked="show" :value="show ? 'true' : 'false'" class="hidden w-full h-full rounded-full appearance-none active:outline-none focus:outline-none"/>
					</div>

					<p class="text-gray-500">Informe Oportunidad</p>
				</div>
			</div>

			<div>
				<!-- Primer select: Grupos -->
				<label for="tipo_servicio" class="block text-sm text-gray-700 capitalize dark:text-gray-200">Grupo Servicio</label>
				<select id="tipo_servicio" name="tipo_servicio" x-model="selectedGroup" @change="updateServices()" x-bind:value="initialState.grupo" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40">
					<option value="" disabled selected>Seleccione un grupo</option>
					<template x-for="(group, groupCode) in groups" :key="groupCode">
						<option :value="groupCode" x-text="group.nombre"></option>
					</template>
				</select>
				<div x-show="errors.tipo_servicio" class="text-red-500 text-[14px]">
					<p x-text="errors.tipo_servicio"></p>
				</div>
			</div>

			<div>
				<label for="servicio_rips_code" class="block text-sm text-gray-700 capitalize dark:text-gray-200">Codigo Servicio</label>
				<select id="servicio_rips_code" name="servicio_rips_code" x-model="initialState.servicio" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" :disabled="!services.length">
					<option value="" disabled selected x-show="!services.length">Seleccione un servicio</option>
					<template x-for="service in services" :key="service.codigo">
						<option :value="service.codigo" x-text="service.nombre"></option>
					</template>
				</select>
				<div x-show="errors.servicio_rips_code" class="text-red-500 text-[14px]">
					<p x-text="errors.servicio_rips_code"></p>
				</div>
			</div>

			<div>
				<label for="diagnostico_defaults" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Diagnostico por defecto</label>
				<select
					id="diagnostico_defaults" name="diagnostico_defaults" x-bind:data-default="initialState.diag" class="codigo-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción..." data-url="{{ path('get_list_diagnostic') }}">
					<!-- Reemplaza con tu URL de búsqueda -->
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				<div x-show="errors.diagnostico_defaults" class="text-red-500 mt-[-20px] text-[14px]">
					<p x-text="errors.diagnostico_defaults"></p>
				</div>
			</div>

			<div>
				<label for="tipo_diagnostico" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Tipo Diagnóstico</label>
				<select id="tipo_diagnostico" name="tipo_diagnostico" x-model="initialState.tipoDiag" class="block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción...">
					<option value="" disabled selected>Seleccione una opción</option>
					<option value="01">Impresión diagnóstica</option>
					<option value="02">Confirmado Nuevo</option>
					<option value="03">Confirmado Repetido</option>
				</select>
				<div x-show="errors.tipo_diagnostico" class="text-red-500 text-[14px]">
					<p x-text="errors.tipo_diagnostico"></p>
				</div>
			</div>

			<div>
				<label for="causa_externa" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Causa Externa</label>
				<select
					id="causa_externa" name="causa_externa" x-bind:data-default="initialState.causa" class="choices-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción..." data-url="{{ path('get_list_external_cause') }}">
					<!-- Reemplaza con tu URL de búsqueda -->
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				<div x-show="errors.causa_externa" class="text-red-500 mt-[-20px] text-[14px]">
					<p x-text="errors.causa_externa"></p>
				</div>
			</div>

			<div>
				<label for="finalidad" class="block text-sm text-gray-700 capitalize dark:text-gray-200 mb-2">Finalidad</label>
				<select id="finalidad" name="finalidad" data-url="{{ path('get_list_finality') }}" x-bind:data-default="initialState.finalidad" class="choices-autocomplete block w-full px-3 py-2 mt-2 text-gray-600 placeholder-gray-400 bg-white border border-gray-200 rounded-md focus:border-indigo-400 focus:outline-none focus:ring focus:ring-indigo-300 focus:ring-opacity-40" data-placeholder="Buscar descripción...">
					<option value="" disabled selected>Seleccione una opción</option>
				</select>
				<div x-show="errors.finalidad" class="text-red-500 mt-[-20px] text-[14px]">
					<p x-text="errors.finalidad"></p>
				</div>
			</div>

			<div class="flex justify-end mt-6 col-span-2">
				<button type="submit" x-text="!itemId ? 'Crear' : 'Actualizar'" class="px-3 py-2 text-sm tracking-wide text-white capitalize transition-colors duration-200 transform bg-green-500 rounded dark:bg-green-600 dark:hover:bg-green-700 dark:focus:bg-green-700 hover:bg-green-600 focus:outline-none focus:bg-green-500 focus:ring focus:ring-green-300 focus:ring-opacity-50"></button>
			</div>
		</div>
	</form>
{% endblock %}
