				this.modalOpenUpdate = true;
				this.itemId = event.detail?.id;
			},
			init() {
				this.$watch('itemId', () => {
					this.loadChoicesData();
				});
			},
			loadChoicesData() {
				if (this.url && this.itemId) {
					fetch(`${this.url}/${this.itemId}`)
					.then(response => response.json())
					.then(data => {
						this.tipoCita = data.tipo_cita;
						this.cups = data.cups;
						this.diag = data.diag;
						this.causa = data.causa_externa;
						this.finalidad = data.finalidad;
						this.grupo = data.grupo;
						this.selectedGroup = data.grupo;
						this.updateServices();
						this.servicio = data.servicio;
						this.tipoDiag = data.tipo_diag;
						this.show = data.informe;
					})
					.catch(error => console.error('Error al cargar opciones iniciales:', error));
				}
			},
        }));
    });

