{% extends 'base.html.twig' %}

{% block title %}Componentes
{% endblock %}

{% block body %}

	<button x-data @click="$dispatch('modal-open', {update: false}); $dispatch('form-update')" class="rounded border p-2 bg-blue-500 text-white hover:bg-blue-400">Modal create</button>
	<button x-data @click="$dispatch('modal-open', {update: true}); $dispatch('form-update', {id: 41})" class="rounded border p-2 bg-blue-500 text-white hover:bg-blue-400">Modal update</button>

	{% include 'forms/form-create.html.twig' %}


	<div x-data>
		<button @click="$dispatch('alert')" class="rounded border p-2 bg-blue-500 text-white hover:bg-blue-400">Alert</button>
	</div>

	{% include 'components/alert-component.html.twig' %}

{% endblock %}
